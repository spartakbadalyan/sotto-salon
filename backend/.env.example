# Sotto Salon backend configuration (synthetic-only foundation).
# Copy to .env for local development. Never commit real secrets or provider keys.
# All variables are prefixed SALON_.

# development | staging | production
SALON_ENVIRONMENT=development

# PostgreSQL DSN. The compose stack publishes this database on 127.0.0.1:5432.
SALON_DATABASE_URL=postgresql+psycopg://salon:salon@127.0.0.1:5432/salon

# Server-side session signing secret. Use a long random value; never reuse across environments.
SALON_SESSION_SECRET=change-me-in-every-environment

# Integration adapters. "synthetic" is a local stand-in with no real provider calls.
# Production refuses synthetic adapters (see salon.core.config).
SALON_VERIFICATION_ADAPTER=synthetic
SALON_PAYMENT_ADAPTER=synthetic

# Browser origins allowed to call the API (CORS). Comma-separated or a JSON list.
SALON_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
